# 复制为 sandbox.toml，替换 api_key 后再启动。此文件不会自动展开环境变量。
[server]
host = "0.0.0.0"
port = 8080
api_key = "REPLACE_WITH_RANDOM_SECRET_BEFORE_STARTING"

[runtime]
type = "docker"
execd_image = "opensandbox/execd:release-1.2.0"

[docker]
network_mode = "bridge"
host_ip = "127.0.0.1"
publish_host = "127.0.0.1"
port_range_min = 40000
port_range_max = 40199
no_new_privileges = true
pids_limit = 256

[proxy]
resolve_internal = false

[storage]
# 不允许用户把任意宿主目录挂载进沙箱。
allowed_host_paths = []

[store]
type = "sqlite"
path = "/var/lib/opensandbox/opensandbox.db"
