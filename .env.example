HARNESS_ENVIRONMENT=development
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8000
HARNESS_DATABASE_URL=postgresql+psycopg://localhost/agent_platform
HARNESS_REDIS_URL=redis://localhost:6379/0
# Set provider credentials when implementing ModelProvider; no model is invoked by the scaffold.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TIMEOUT=5

# 账号认证模块：会话有效期与登录限流
AUTH_SESSION_TTL=28800
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW=300
