HARNESS_ENVIRONMENT=development
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8000
HARNESS_CHECKPOINT_BACKEND=redis
HARNESS_WORKER_ENABLED=true
HARNESS_WORKER_CONCURRENCY=1
HARNESS_TASK_QUEUE_STREAM=agent_platform:tasks
HARNESS_TASK_QUEUE_GROUP=agent_platform:task_workers

HARNESS_DEVELOPMENT_TOKEN=123456
HARNESS_DEVELOPMENT_PRINCIPAL='{"tenant_id":1,"user_id":1,"project_id":"local"}'

#redis
REDIS_URL=redis://192.168.1.250:6379/0
# 选用 PostgreSQL checkpoint 时再配置。
POSTGRES_URL=postgresql://用户名:密码@localhost:5432/数据库名

HARNESS_DATABASE_URL=postgresql+psycopg://用户名:密码@localhost:5432/数据库名

HARNESS_LANGFUSE_ENABLED=false

LANGFUSE_SECRET_KEY="1111"
LANGFUSE_PUBLIC_KEY="1111"
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TIMEOUT=5

# Set provider credentials when implementing ModelProvider; no model is invoked by the scaffold.

DEEPSEEK_MODEL_NAME=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=11111

OPENAI_MODEL_NAME=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=1111

QWEN_MODEL_NAME=deepseek-flash
QWEN_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=1111


# OpenSandbox 服务器的地址
OPENSANDBOX_DOMAIN=192.168.1.250:1998
# 与服务器 sandbox.toml 中的 api_key 一致
OPENSANDBOX_API_KEY=1111
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_IMAGE=python:3.12